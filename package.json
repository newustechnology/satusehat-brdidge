{
  "name": "satusehat-brdidge",
  "version": "1.0.1-beta.0",
  "description": "Integrasi Satusehat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "repository": "https://github.com/newustechnology/satusehat-brdidge.git",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "satusehat",
    "bridging",
    "kemenkes"
  ],
  "files": [
    "dist/**/*"
  ],
  "author": "Newus Teknologi",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npx jest --detectOpenHandles",
    "prepare": "npm run build",
    "release": "npm version patch && git push && git push --tags",
    "release:beta": "npm version prerelease --preid=beta && git push && git push --tags",
    "publish:public": "npm run build && npm publish --access public",
    "publish:beta": "npm run build && npm publish --tag beta --access public"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "node-cache": "^5.1.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
